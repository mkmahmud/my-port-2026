# EmailJS Configuration for Contact Me form
# EmailJS sends directly from the browser, so these MUST use the
# NEXT_PUBLIC_ prefix or Next.js will not expose them to client code.
# Create an account at https://www.emailjs.com/
# 1. Create an Email Service (e.g. Gmail) -> get Service ID
# 2. Create an Email Template -> get Template ID
#    Recommended template variables: {{name}}, {{email}}, {{phone}}, {{service}}, {{budget}}, {{country}}, {{message}}
# 3. Account Settings -> API Keys -> get Public Key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CONTACT_RECIPIENT_EMAIL=mkmahmud.dev@gmail.com
